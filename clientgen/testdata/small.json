{
  "capabilities": [
    {
      "name": "shop.orders.create",
      "version": 1,
      "title": "Place an order",
      "description": "Places an order for a customer and waits for the payment to settle.\nAn order with no items is refused.",
      "long": true,
      "input": {
        "type": "object",
        "properties": {
          "customer": {"type": "string", "description": "customer id"},
          "items": {
            "type": "array",
            "description": "what is ordered, at least one",
            "items": {
              "type": "object",
              "properties": {
                "sku": {"type": "string"},
                "quantity": {"type": "integer", "description": "how many, 1 or more"},
                "note": {"type": "string"}
              },
              "required": ["sku", "quantity"],
              "additionalProperties": false
            }
          },
          "priority": {"type": "string", "enum": ["low", "normal", "high"], "description": "how soon it ships"},
          "shipping": {
            "type": "object",
            "description": "where it goes; absent for a pick-up",
            "properties": {
              "address": {"type": "string"},
              "postal-code": {"type": "string"}
            },
            "required": ["address"]
          },
          "tags": {"type": "object", "additionalProperties": {"type": "string"}},
          "attachment": {"type": "string", "contentEncoding": "base64", "description": "a purchase order, as sent"},
          "metadata": {"description": "anything the caller wants kept with the order"},
          "discount": {"type": ["number", "null"], "description": "null for none"},
          "gift": {"type": "boolean"}
        },
        "required": ["customer", "items", "discount"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "paid"]},
          "total": {"type": "number"},
          "createdAt": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "status", "total", "createdAt"]
      }
    },
    {
      "name": "shop.orders.list",
      "version": 1,
      "title": "List orders",
      "input": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "description": "max items; default 50, max 500"},
          "cursor": {"type": "string", "description": "opaque, from a previous next"}
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"id": {"type": "string"}, "total": {"type": "number"}},
              "required": ["id", "total"]
            }
          },
          "next": {"type": "string"}
        },
        "required": ["items"]
      }
    },
    {
      "name": "shop.ping",
      "version": 1,
      "title": "Check the shop answers"
    },
    {
      "name": "shop.ping",
      "version": 2,
      "title": "Check the shop answers, and say who asks",
      "input": {"type": "object"},
      "output": {"type": "array", "items": {"type": "string"}}
    },
    {
      "name": "media.blob.read",
      "version": 1,
      "title": "Read a window of a blob",
      "input": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "offset": {"type": "integer", "description": "byte offset"},
          "limit": {"type": "integer", "description": "bytes to read"}
        },
        "required": ["id"]
      },
      "output": {
        "type": "object",
        "properties": {
          "data": {"type": "string", "contentEncoding": "base64"},
          "eof": {"type": "boolean"},
          "total": {"type": "integer"}
        },
        "required": ["data", "eof", "total"]
      }
    },
    {
      "name": "media.tree.get",
      "version": 1,
      "title": "Get a folder tree",
      "input": {
        "type": "object",
        "properties": {"root": {"type": "string"}},
        "required": ["root"]
      },
      "output": {
        "$ref": "#/$defs/Node",
        "$defs": {
          "Kind": {"type": "string", "enum": ["file", "folder"], "description": "What a node is."},
          "Node": {
            "type": "object",
            "description": "One file or folder.",
            "properties": {
              "name": {"type": "string"},
              "kind": {"$ref": "#/$defs/Kind"},
              "children": {"type": "array", "items": {"$ref": "#/$defs/Node"}},
              "parent": {"$ref": "#/$defs/Node"},
              "link": {"oneOf": [{"type": "string"}, {"type": "object"}], "description": "a path, or a link record"},
              "2d": {"type": "boolean"},
              "extra": {"type": "object"},
              "sizes": {"type": "object", "additionalProperties": {"type": "integer"}},
              "owner": {"anyOf": [{"type": "string"}, {"type": "null"}]}
            },
            "required": ["name", "kind"]
          }
        }
      }
    }
  ]
}
